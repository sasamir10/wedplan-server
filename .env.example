PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
MONGODB_DB_NAME=wedplan

BETTER_AUTH_SECRET=replace_with_a_secure_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional local-development DNS override for Node.js DNS queries.
# Used only when NODE_ENV=development; leave unset to use the system resolver.
# WEDPLAN_DNS_SERVERS=8.8.8.8,8.8.4.4
